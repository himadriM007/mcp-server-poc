{
  "name": "mcp-server",
  "version": "0.0.1",
  "description": "MCP server exposing the API-server user endpoints as tools",
  "private": true,
  "type": "module",
  "bin": {
    "mcp-server": "dist/index.js"
  },
  "scripts": {
    "server:build": "tsc",
    "server:build:watch": "tsc --watch",
    "server:dev": "node dist/index.js",
    "server:inspect": "set DANGEROUSLY_OMIT_AUTH=true && npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
